# ── strands-cad printer cockpit — copy to .env and fill in ──────────────────
# Printer (Bambu Lab X2D / H2D / P1 / X1)
BAMBU_IP=192.168.1.164
BAMBU_ACCESS_CODE=xxxxxxxx        # shown on the printer screen — ROTATES, update when it changes
BAMBU_SERIAL=

# Model (Bedrock)
MODEL_PROVIDER=bedrock
STRANDS_MODEL_ID=global.anthropic.claude-opus-4-8
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2

# ── Telegram bridge ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=

# ── 🧠 Slow-thinker loop ────────────────────────────────────────────────────
THINKER_INTERVAL=60
# THINKER_DISABLED=1              # set to disable the background thinker

# ── Slicer (OrcaSlicer emits Bambu-flavored gcode; PrusaSlicer does NOT) ─────
STRANDS_CAD_SLICER=

# ── Split-loops (set by docker/systemd; dashboard won't double-run loops) ────
# STRANDS_CAD_SPLIT_LOOPS=1
