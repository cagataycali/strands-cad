[Unit]
Description=strands-cad — dashboard (WebAuthn printer cockpit on :8099)
PartOf=strands-cad.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@INSTALL_DIR@
EnvironmentFile=-@INSTALL_DIR@/.env
Environment=STRANDS_CAD_SPLIT_LOOPS=1
# Passkeys ON by default: a printer heats and moves, and this port is usually behind a public tunnel.
# To run without auth on a trusted LAN set STRANDS_CAD_DASHBOARD_ARGS=--no-auth in .env (explicit, never the default).
# Behind a tunnel also set STRANDS_CAD_AUTH_RP_ID=<host> and STRANDS_CAD_AUTH_ORIGIN=https://<host> in .env.
Environment=STRANDS_CAD_DASHBOARD_ARGS=
ExecStart=@VENV@/bin/strands-cad-dashboard $STRANDS_CAD_DASHBOARD_ARGS
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=strands-cad.target default.target
